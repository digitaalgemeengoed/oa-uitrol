{
  "realm": "gemeenten",
  "displayName": "Office Assistent — prototype",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "nl",
    "en"
  ],
  "defaultLocale": "nl",
  "roles": {
    "realm": [
      {
        "name": "medewerker",
        "description": "Werkt met de assistent in de werkomgeving"
      },
      {
        "name": "beheerder",
        "description": "Beheert objecttypen en regels van de eigen gemeente"
      },
      {
        "name": "leverancier",
        "description": "Handelt namens een gemeente, alleen met een geldige delegatie"
      }
    ]
  },
  "clients": [
    {
      "clientId": "oa-integratielaag",
      "name": "Integratielaag Office Assistent",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${OA_BASIS_URL}/api/auth/terug"
      ],
      "webOrigins": [
        "${OA_BASIS_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${OA_BASIS_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "gemeente",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "gemeente",
            "claim.name": "gemeente",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "leverancier",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "leverancier",
            "claim.name": "leverancier",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255}}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255}}},{\"name\":\"gemeente\",\"displayName\":\"Gemeente\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"validations\":{\"pattern\":{\"pattern\":\"^[a-z0-9-]{2,40}$\"}}}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "test.haarlem",
      "enabled": true,
      "firstName": "Femke",
      "lastName": "de Vries (test)",
      "email": "test.haarlem@example.org",
      "emailVerified": true,
      "attributes": {
        "gemeente": [
          "haarlem"
        ]
      },
      "realmRoles": [
        "medewerker",
        "default-roles-gemeenten"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${OA_TESTWACHTWOORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    },
    {
      "username": "test.zandvoort",
      "enabled": true,
      "firstName": "Sanne",
      "lastName": "Visser (test)",
      "email": "test.zandvoort@example.org",
      "emailVerified": true,
      "attributes": {
        "gemeente": [
          "zandvoort"
        ]
      },
      "realmRoles": [
        "medewerker",
        "default-roles-gemeenten"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${OA_TESTWACHTWOORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    },
    {
      "username": "beheer.haarlem",
      "enabled": true,
      "firstName": "Joost",
      "lastName": "Bakker (test, beheerder)",
      "email": "beheer.haarlem@example.org",
      "emailVerified": true,
      "attributes": {
        "gemeente": [
          "haarlem"
        ]
      },
      "realmRoles": [
        "medewerker",
        "beheerder",
        "default-roles-gemeenten"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${OA_TESTWACHTWOORD}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    }
  ]
}
