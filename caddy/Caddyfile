# Caddy haalt zelf certificaten op voor beide namen.

oa.{$DOMEIN} {
	encode zstd gzip
	# Wie deze pagina's in een iframe mag zetten, bepaalt de integratielaag zelf
	# (frame-ancestors): alleen zijzelf, en voor /word/ ook Word voor het web.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy integratielaag:3000
}

id.{$DOMEIN} {
	# Keycloak op VPS 3, over het private netwerk. Het beheerscherm niet naar buiten.
	@beheer path /admin*
	respond @beheer "Niet beschikbaar" 404
	reverse_proxy {$KEYCLOAK_INTERN}
}

office.{$DOMEIN} {
	# Collabora Online (profiel "collabora" in vps1-toegang.yml). Zonder dat
	# profiel geeft dit adres 502; met het DNS-record office.<domein> erbij.
	# De voorpagina (alleen "/") is een overzicht van de werkomgevingen en
	# downloads (caddy/office/index.html); Collabora gebruikt "/" zelf niet.
	header Strict-Transport-Security "max-age=31536000"
	@voorpagina path / /index.html
	handle @voorpagina {
		root * /etc/caddy/office
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		file_server
	}
	handle {
		reverse_proxy collabora:9980
	}
}

oa-admin.{$DOMEIN} {
	# Het beheerportaal (oa-beheer). Alle beveiligingskoppen behalve HSTS zet
	# het portaal zelf; het antwoordt alleen op deze hostnaam.
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy beheer:4300
}
