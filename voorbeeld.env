# Kopieer naar .env op elke VPS en vul in. Zet .env nooit in git.
# Sleutels: minstens 32 willekeurige tekens, bv. `openssl rand -base64 36`.

OA_VERSIE=0.2.0
DOMEIN=prototype.example.nl

# WireGuard-adressen (server/koppelen.sh): toegang .1, platform .2, diensten .3.
# Verkeer tussen de VPS'en loopt alleen daarover. PRIVAAT_ADRES is het adres
# van de VPS zelf. server/installeer.sh schrijft dit bestand voor je.
PRIVAAT_ADRES=10.66.0.2
PLATFORM_INTERN=http://10.66.0.2:4100
DIENSTEN_INTERN=http://10.66.0.3:4200
KEYCLOAK_INTERN=10.66.0.3:8080

# Gedeelde sleutels tussen integratielaag en platform/diensten (op beide VPS'en gelijk)
PLATFORM_DIENSTSLEUTEL=
DIENSTEN_DIENSTSLEUTEL=

# VPS 2
PG_BEHEER_WACHTWOORD=
PG_APP_WACHTWOORD=
S3_SLEUTEL=
S3_GEHEIM=
# Vastgepinde versie van SILO; bijwerken na de release notes
SILO_VERSIE=RELEASE.2026-10-26T00-00-00Z
GEMEENTEN=haarlem:Gemeente Haarlem,zandvoort:Gemeente Zandvoort

# Zoekindex (OA-ADR-007): "uit" of "opensearch"; bij opensearch ook COMPOSE_PROFILES=zoeken op VPS 2
ZOEKINDEX=uit
OPENSEARCH_VERSIE=3.8.0
OPENSEARCH_GEHEUGEN=1g

# Sleutelbeheer (OA-ADR-008): "uit" of "openbao"; OpenBao draait op VPS 3 (COMPOSE_PROFILES=sleutels).
# Het token voor het platform komt uit openbao/init.sh.
SLEUTELBEHEER=uit
OPENBAO_INTERN=http://10.66.0.3:8200
OPENBAO_TOKEN=
OPENBAO_VERSIE=2.7.2

# VPS 3 en VPS 1 (client secret op beide gelijk)
KC_DB_WACHTWOORD=
KC_BEHEERDER=beheer
KC_BEHEERDER_WACHTWOORD=
OIDC_CLIENT_SECRET=
# Eerste (tijdelijke) wachtwoord van de testgebruikers in Keycloak
OA_TESTWACHTWOORD=

# VPS 1: "oidc" met Keycloak; "dev" alleen voor een afgeschermde demo zonder echte gegevens
OA_AUTH=oidc
