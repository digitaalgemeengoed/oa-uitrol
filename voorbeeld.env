# Kopieer naar .env op elke VPS en vul in. Zet .env nooit in git.
# Sleutels: minstens 32 willekeurige tekens, bv. `openssl rand -base64 36`.

OA_VERSIE=0.1.0
DOMEIN=prototype.example.nl

# Private adressen (provider-netwerk of WireGuard) — verkeer tussen de VPS'en
# loopt alleen daarover.
PRIVAAT_ADRES=10.0.0.2
PLATFORM_INTERN=http://10.0.0.2:4100
DIENSTEN_INTERN=http://10.0.0.3:4200
KEYCLOAK_INTERN=10.0.0.3:8080

# Gedeelde sleutels tussen integratielaag en platform/diensten (op beide VPS'en gelijk)
PLATFORM_DIENSTSLEUTEL=
DIENSTEN_DIENSTSLEUTEL=

# VPS 2
PG_BEHEER_WACHTWOORD=
PG_APP_WACHTWOORD=
S3_SLEUTEL=
S3_GEHEIM=
GEMEENTEN=haarlem:Gemeente Haarlem,zandvoort:Gemeente Zandvoort

# VPS 3 en VPS 1 (client secret op beide gelijk)
KC_DB_WACHTWOORD=
KC_BEHEERDER=beheer
KC_BEHEERDER_WACHTWOORD=
OIDC_CLIENT_SECRET=

# VPS 1: "oidc" met Keycloak; "dev" alleen voor een afgeschermde demo zonder echte gegevens
OA_AUTH=oidc
